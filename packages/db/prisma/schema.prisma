generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  phone            String         @unique
  passwordHash     String
  fullName         String
  role             Role           @default(RESELLER)
  status           UserStatus     @default(ACTIVE)
  kycTier          Int            @default(1)
  twoFactorSecret  String?
  parentId         String?
  parent           User?          @relation("Tree", fields: [parentId], references: [id])
  children         User[]         @relation("Tree")
  wallets          Wallet[]
  apiKeys          ApiKey[]
  pricingRules     PricingRule[]
  orders           Order[]
  supportMessages  SupportMessage[] @relation("SupportMessageUser")
  adminMessages    SupportMessage[] @relation("SupportMessageAdmin")
  refunds          RefundRecord[] @relation("RefundUser")
  createdRefunds   RefundRecord[] @relation("RefundCreator")
  withdrawals     WithdrawalRequest[] @relation("WithdrawalUser")
  processedWithdrawals WithdrawalRequest[] @relation("WithdrawalProcessor")
  refreshTokens    RefreshToken[]
  walletTransactions WalletTransaction[]
  fundingRequests FundingRequest[]
  passwordResetTokens PasswordResetToken[]
  adminAuditLogs AdminAuditLog[]
  adminPermissions AdminPermission[]
  supportTickets SupportTicket[]
  notifications Notification[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([parentId])
  @@index([status])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Wallet {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  type          WalletType    @default(MAIN)
  currency      String        @default("NGN")
  balance       Decimal       @default(0) @db.Decimal(18, 2)
  lockedBalance Decimal       @default(0) @db.Decimal(18, 2)
  entries       LedgerEntry[]

  @@unique([userId, type, currency])
}

model LedgerEntry {
  id           String    @id @default(cuid())
  walletId     String
  wallet       Wallet    @relation(fields: [walletId], references: [id])
  direction    Direction
  amount       Decimal   @db.Decimal(18, 2)
  balanceAfter Decimal   @db.Decimal(18, 2)
  reference    String    @unique
  description  String
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([walletId, createdAt])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  serviceType     ServiceType
  customerRef     String      @unique
  providerRef     String?
  providerSession String?
  status          OrderStatus @default(PENDING)
  amountCost      Decimal     @db.Decimal(18, 2)
  amountSold      Decimal     @db.Decimal(18, 2)
  profit          Decimal     @db.Decimal(18, 2)
  requestPayload  Json
  responsePayload Json?
  apiResponse     String?
  failureReason   String?
  idempotencyKey  String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  refund          RefundRecord?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([providerRef])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  name       String
  keyHash    String    @unique
  keyPrefix  String
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PricingRule {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  serviceType ServiceType
  serviceId   String?
  markupType  MarkupType
  markupValue Decimal    @db.Decimal(18, 2)
  minAmount   Decimal?   @db.Decimal(18, 2)
  maxAmount   Decimal?   @db.Decimal(18, 2)

  @@index([userId, serviceType])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventType, processedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorRole Role?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

model ProviderLog {
  id           String   @id @default(cuid())
  method       String
  url          String
  requestBody  Json?
  responseBody Json?
  statusCode   Int
  durationMs   Int
  error        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model WalletTransaction {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String
  amountKobo    BigInt
  description   String
  reference     String    @unique
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  walletId      String?
  eventId       String?

  @@index([userId, createdAt(sort: Desc)])
}

model FundingRequest {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountKobo    BigInt
  reference     String    @unique
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([reference])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, tokenHash])
  @@index([tokenHash])
}

model AdminAuditLog {
  id         String    @id @default(cuid())
  adminUserId String
  admin      User      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([adminUserId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
}

model AdminPermission {
  id           String    @id @default(cuid())
  adminUserId  String
  admin        User      @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  permission   String
  granted      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([adminUserId, permission])
  @@index([adminUserId])
}

model SupportTicket {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  category    String
  priority    String    @default("medium")
  status      String    @default("open")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model SupportMessage {
  id        String    @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation("SupportMessageUser", fields: [userId], references: [id], onDelete: SetNull)
  adminId   String?
  admin     User?     @relation("SupportMessageAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  message   String
  createdAt DateTime  @default(now())

  @@index([ticketId, createdAt(sort: Asc)])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  isRead    Boolean   @default(false)
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  active    Boolean   @default(true)
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, createdAt(sort: Desc)])
}

model Promotion {
  id        String    @id @default(cuid())
  title     String
  content   String
  type      String    @default("announcement")
  active    Boolean   @default(true)
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type, active])
}

model Product {
  id             String     @id @default(cuid())
  provider       String
  providerProductId String   @unique
  name           String
  description    String?
  serviceType    ServiceType
  category       String?
  priceKobo      BigInt     @default(0)
  minAmountKobo  BigInt?
  maxAmountKobo  BigInt?
  markupPercent  Decimal?   @db.Decimal(6, 2)
  active         Boolean    @default(true)
  metadata       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt


  @@index([serviceType])
  @@index([category])
  @@index([active])
  @@index([provider])
}

model ProductSyncLog {
  id         String   @id @default(cuid())
  provider   String
  synced     Int
  updated    Int
  deactivated Int
  errors     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model RefundRecord {
  id          String    @id @default(cuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id])
  userId      String
  user        User      @relation("RefundUser", fields: [userId], references: [id])
  amountKobo  BigInt
  reason      String
  reference   String    @unique
  status      String    @default("pending")
  createdBy   String?
  createdById String?
  creator    User?     @relation("RefundCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model WithdrawalRequest {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("WithdrawalUser", fields: [userId], references: [id], onDelete: Cascade)
  amountKobo    BigInt
  destination   String
  reference     String    @unique
  status        String    @default("pending")
  note         String?
  processedBy   String?
  processedById String?
  processor     User?     @relation("WithdrawalProcessor", fields: [processedById], references: [id])
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RESELLER
  SUB_RESELLER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_KYC
}

enum WalletType {
  MAIN
  COMMISSION
  GIFT_CARD
  REFERRAL
}

enum Direction {
  DEBIT
  CREDIT
}

enum ServiceType {
  AIRTIME
  DATA
  ELECTRICITY
  TV
  EDUCATION
  PRINT_CARD
  BULK_SMS
  SOCIAL_BOOST
  BUY_LOGS
  ECOMMERCE
  MARKETPLACE
  GIFT_CARD
  VIRTUAL_NUMBER
  EMAIL
  ESIM
}

enum OrderStatus {
  PENDING
  PROCESSING
  PENDING_PROCESSING
  SUCCESSFUL
  FAILED
  AWAITING_FULFILLMENT
  CANCELLED
  REFUNDED
}

enum MarkupType {
  PERCENT
  FIXED
}
