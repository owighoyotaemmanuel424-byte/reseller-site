# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# External reseller provider (server-side only)
RESELLER_API_BASE_URL=
RESELLER_API_KEY=
MARKUP_PERCENT=10

# Paystack (server-side only)
# Never expose this as NEXT_PUBLIC_*
PAYSTACK_SECRET_KEY=

# Application URL
NEXT_PUBLIC_SITE_URL=

# Optional webhook configuration
PAYMENT_WEBHOOK_SECRET=

# Production notes
# - Do not commit .env files
# - Configure secrets in Cloudflare/Vercel/GitHub environment settings
# - Rotate any secret that may have been exposed
