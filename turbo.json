{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "AUTH_SESSION_SECRET",
    "ADMIN_SESSION_SECRET",
    "ADMIN_BOOTSTRAP_SECRET",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "ENCRYPTION_KEY",
    "WEBHOOK_SIGNING_SECRET",
    "JEJELAYE_API_BASE_URL",
    "JEJELAYE_API_TOKEN",
    "MARKUP_PERCENT",
    "PAYSTACK_SECRET_KEY",
    "FLUTTERWAVE_SECRET_KEY",
    "MONNIFY_API_KEY",
    "MONNIFY_SECRET_KEY",
    "RESEND_API_KEY",
    "TERMII_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": ["coverage/**"]
    }
  }
}